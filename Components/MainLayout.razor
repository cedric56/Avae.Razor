@using Avae.Razor
@using Avae.Services
@using Avae.ViewModels
@using Microsoft.JSInterop
@using MudBlazor
@inherits LayoutComponentBase
@implements IDisposable
@inject IRequestedThemeService themeService
@inject IRuntime runtime
@inject IMvvmManager mvvmmanager
@inject NavigationManager manager
@inject IServiceProvider provider
@inject Func<IServiceProvider, Task> initialize
@inject IJSRuntime js

<MudThemeProvider IsDarkMode="Service.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        @Title
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <MudNavMenu>
            @foreach (var item in mvvmmanager.Navigables)
            {
                <MudNavLink OnClick="@(async () => await OnNavClick(item))">
                    @item.DisplayName
                </MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>
   
    <MudMainContent>
        @if(mvvmmanager.CurrentView is ViewFor viewFor)
        {
            <DynamicComponent              
                Type="@viewFor.Type" 
                Parameters="@viewFor.Parameters"
                />
        }
    </MudMainContent>
</MudLayout>

@code
{
    public string Title { get; set; } = "Application";

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task OnNavClick(NavigableView item)
    {
        await mvvmmanager.OnNavigableChanged(item);
        manager.NavigateTo(item.Href, false);// runtime.Current == Runtime.BlazorServer);
        await InvokeAsync(StateHasChanged);
    }

    private RequestThemeService Service => ((RequestThemeService)themeService);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        mvvmmanager.CurrentViewChanged += CurrentViewChanged;
        Service.RequestedThemeChanged += ThemeChanged;
    }

    async void CurrentViewChanged(object? sender, IViewFor? view)
    {
        mvvmmanager.CurrentViewChanged -= CurrentViewChanged;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await initialize(provider);
            await ApplyThemeAsync();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    async void ThemeChanged(object? sender, RequestedTheme theme)
    {
        await ApplyThemeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyThemeAsync()
    {
        try
        {
            await js.InvokeVoidAsync(
                "document.documentElement.setAttribute",
                "data-wui-theme",
                Service.IsDarkMode ? "dark" : "light");
        }
        catch (JSDisconnectedException) { }
    }

    public void Dispose()
    {
        mvvmmanager.CurrentViewChanged -= CurrentViewChanged;
        Service.RequestedThemeChanged -= ThemeChanged;
    }
} 