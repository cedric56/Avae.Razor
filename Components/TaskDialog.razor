@using Avae.Services
@using MudBlazor
<MudDialog>
    <TitleContent>
        @if (!string.IsNullOrWhiteSpace(Parameters.Title))
        {
            <MudText Typo="Typo.h6">@Parameters.Title</MudText>
        }        
    </TitleContent>

    <DialogContent>
        <div class="dialog-header-row">
            @if (Parameters.IconSource is ViewFor icon)
            {
                <div class="dialog-header-icon">
                    @icon.Content
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Parameters.Header))
            {
                <MudText Typo="Typo.h5" class="dialog-header-title">@Parameters.Header</MudText>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Parameters.SubHeader))
        {
            <div class="dialog-subheader">@Parameters.SubHeader</div>
        }
        @if (Parameters.Content is ViewFor content)
        {
            @content.Content
        }
        @if (Parameters.ShowProgressBar)
        {
            <div class="dialog-progress"><div class="dialog-progress-indeterminate"></div></div>
        }
        @if (Parameters.FooterVisibility != TaskDialogFooterVisibility.Never && Parameters.Footer != null)
        {
            @if (Parameters.FooterVisibility == TaskDialogFooterVisibility.Auto)
            {
                <MudButton class="dialog-footer-toggle" onclick="ToggleFooter">
                    @(_footerExpanded ? "Less details" : "More details")
                </MudButton>
            }
            @if (_footerExpanded && Parameters.Footer is ViewFor footer)
            {
                @footer.Content
            }
        }

    </DialogContent>

    <DialogActions>
        @foreach (var result in Results)
        {
@*             Color = "@(result == Parameters.DefaultResult ? Color.Primary : Color.Default)"
 *@
            <MudButton class="dialog-action"
                       Color="Color.Default"
                       OnClick="@(() => SetResult(result))">
                @Label(result)
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .dialog-header-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dialog-header-icon {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .dialog-header-title {
        flex: 1 1 auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {

    private bool _footerExpanded;

    protected override void OnInitialized()
    {
        _footerExpanded = Parameters.FooterVisibility == TaskDialogFooterVisibility.Always
            || Parameters.IsFooterExpanded;
        Parameters.Opened?.Invoke();
    }

    private void ToggleFooter() => _footerExpanded = !_footerExpanded;

    [CascadingParameter]
    public required IMudDialogInstance Instance { get; set; }

    [Parameter]
    public required TaskDialogParams Parameters { get; set; }

    [Parameter]
    public required TaskDialogStandardResult[] Results { get; set; }

    private static string Label(TaskDialogStandardResult r) => r switch
    {
        TaskDialogStandardResult.OK => "Ok",
        TaskDialogStandardResult.Cancel => "Cancel",
        TaskDialogStandardResult.Yes => "Yes",
        TaskDialogStandardResult.No => "No",
        TaskDialogStandardResult.Retry => "Retry",
        TaskDialogStandardResult.Close => "Close",
        _ => r.ToString()
    };

    private void SetResult(TaskDialogStandardResult result)
    {
        if (true == Parameters.Closing?.Invoke())
            return;

        Instance.Close(result);

        Parameters.Closed?.Invoke();
    }
}
